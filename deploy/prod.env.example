# ─────────────────────────────────────────────────────────────
# Production environment for the Domain Security Scanner.
#
# This is the TEMPLATE for the `PROD_ENV` GitHub Actions secret.
# The deploy workflow writes the secret's contents verbatim to
# /opt/dn-sec/.env on the VM, which systemd loads via EnvironmentFile.
#
# To update production config/secrets: edit the values, then
#   gh secret set PROD_ENV < prod.env       (from a filled-in copy — DO NOT commit it)
# The next push to main (or a manual "Run workflow") redeploys with them.
#
# Format: plain KEY=value, one per line. No `export`, no surrounding quotes
# (both systemd EnvironmentFile and dotenv parse this).
# ─────────────────────────────────────────────────────────────

# ── Runtime ──
NODE_ENV=production
PORT=80
APP_URL=https://dn-sec.com
DB_DIR=/opt/dn-sec/data
REDIS_URL=redis://localhost:6379

# ── OAuth (Google) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dn-sec.com/api/auth/google/callback

# ── OAuth (GitHub) ──
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://dn-sec.com/api/auth/github/callback

# ── Admin (comma-separated emails granted the admin role) ──
ADMIN_EMAILS=

# ── Email notifications (Resend) ──
RESEND_API_KEY=
FROM_EMAIL=notifications@dn-sec.com

# ── External threat/cert APIs ──
GOOGLE_SAFE_BROWSING_KEY=
URLHAUS_AUTH_KEY=
CERTSPOTTER_API_KEY=

# ── Logging / observability (optional) ──
LOG_LEVEL=info
# AXIOM_TOKEN=
# AXIOM_DATASET=

# NOTE: PDF export is intentionally disabled on the e2-micro (PDF_EXPORT_ENABLED unset).
